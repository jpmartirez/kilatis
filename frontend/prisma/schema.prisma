generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  investigator
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  password_hash String   @map("password_hash")
  role          Role     @default(investigator)

  // Tracking which admin created this investigator account
  created_by_id String?  @map("created_by_id")
  createdBy     User?    @relation("UserCreator", fields: [created_by_id], references: [id], onDelete: SetNull)
  createdUsers  User[]   @relation("UserCreator")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("users")
}
